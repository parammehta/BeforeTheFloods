# Copy to .env and fill in. Vite only exposes vars prefixed with VITE_.
#
# WARNING: this is a static site. Anything here is compiled into the JS bundle
# and is readable by anyone who loads the page. Restrict the keys accordingly.

# Google Maps JavaScript API key, with "Places API (New)" enabled.
# Restrict it by HTTP referrer to your deployed origin.
# https://console.cloud.google.com/google/maps-apis/credentials
VITE_GOOGLE_MAPS_API_KEY=

# OpenWeatherMap API key (free "Current Weather" + "5 day / 3 hour forecast").
# OWM has no referrer restriction, so set a call cap on the account.
# https://home.openweathermap.org/api_keys
VITE_OPENWEATHER_API_KEY=
